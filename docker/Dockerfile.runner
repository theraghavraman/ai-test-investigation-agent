# Test-execution image: deliberately NO Docker CLI, API keys, or project dependencies.
# For a project needing additional packages, build/review a separately pinned runner.
# Pinned by digest (multi-arch index). Refresh: see README, 'Updating pinned dependencies'.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
COPY docker/runner-requirements.lock /tmp/runner-requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/runner-requirements.lock \
    && rm /tmp/runner-requirements.lock \
    && printf '%s\n' '[pytest]' 'addopts = -p no:cacheprovider' > /opt/pytest.ini
RUN useradd --uid 65534 --non-unique --no-create-home --shell /usr/sbin/nologin sandbox || true
USER 65534:65534
WORKDIR /workspace
