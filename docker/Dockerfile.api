# Pinned by digest (multi-arch index). Refresh: see README, 'Updating pinned dependencies'.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /service
COPY pyproject.toml requirements.lock ./
# Exact, hash-verified dependency versions; then the app itself without resolving anything new.
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
RUN pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home --shell /usr/sbin/nologin agent
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "127.0.0.1"]
