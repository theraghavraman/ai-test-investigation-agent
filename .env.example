# Replace with unique high-entropy secrets. Do not commit a populated .env.
API_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET_FOR_API_AUTHENTICATION
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini
# --- Local model instead of OpenAI (no API key, no cost) ---
# Leave OPENAI_API_KEY empty, set OPENAI_MODEL to the local model id, and uncomment:
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_CALL_TIMEOUT_SECONDS=600
# INVESTIGATION_TIMEOUT_SECONDS=1200
POSTGRES_PASSWORD=replace_with_strong_alphanumeric_postgres_password
REDIS_PASSWORD=replace_with_strong_alphanumeric_redis_password
RUNNER_IMAGE=ai-test-runner:local
# Export an absolute HOST_DATA_DIR in your shell before docker compose.
